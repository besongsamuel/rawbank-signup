# Environment Variables Example
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# OpenAI API Key (for AI ID extraction Lambda function)
# Set via: npx ampx sandbox secret set OPENAI_API_KEY
# OPENAI_API_KEY=sk-your-key-here

# Amplify generates amplify_outputs.json automatically during sandbox
# No AWS credentials needed locally when using sandbox

# Optional: Override Vite port
# VITE_PORT=3000
