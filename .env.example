# Environment Variables Example
# Copy this file to .env for local development overrides
# DO NOT commit .env to git

# ============================================
# AWS Amplify Gen 2 Configuration
# ============================================

# OpenAI API Key (for AI ID extraction Lambda function)
# Set via Amplify sandbox secrets (NOT in .env):
#   npx ampx sandbox secret set OPENAI_API_KEY
# The Lambda function reads this from process.env.OPENAI_API_KEY
# NEVER commit this value to git

# Example (DO NOT uncomment with real value):
# OPENAI_API_KEY=sk-your-key-here

# ============================================
# Amplify generates amplify_outputs.json automatically
# No AWS credentials needed locally when using sandbox
# ============================================

# Optional: Override Vite dev server port
# VITE_PORT=3000

# Optional: Node environment
# NODE_ENV=development

# ============================================
# How to Set Secrets for Amplify Sandbox
# ============================================
#
# 1. Start sandbox:
#    npx ampx sandbox
#
# 2. Set secret (prompted for value):
#    npx ampx sandbox secret set OPENAI_API_KEY
#
# 3. List secrets:
#    npx ampx sandbox secret list
#
# 4. Remove secret:
#    npx ampx sandbox secret remove OPENAI_API_KEY
#
# For production deployment, set via:
#    npx ampx secret set OPENAI_API_KEY --environment production
#
# ============================================

